{
  "name": "ai-chat-hub-backend",
  "version": "1.0.1",
  "description": "Secure proxy for AI Chat Hub",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "test": "node tests/chat-security.test.js && node tools/smoke-node.js && node tools/interaction-test.js",
    "lint": "eslint .",
    "check": "node tools/syntax-check.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.16",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13"
