{
  "name": "abot",
  "version": "2.8.3",
  "description": "ABot — multi-model AI chat (vanilla ES modules + Tailwind) with a hardened Vercel proxy, Firebase Auth/Firestore, and 31 models across four free-tier providers.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Basith AbuSyed",
  "keywords": [
    "ai-chat",
    "llm",
    "multi-model",
    "gemini",
    "groq",
    "nvidia-nim",
    "openrouter",
    "vanilla-js",
    "tailwindcss",
    "firebase",
    "pwa",
    "sse-streaming",
    "vercel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abustark/abot.git"
  },
  "bugs": {
    "url": "https://github.com/abustark/abot/issues"
  },
  "homepage": "https://abot-ai.vercel.app/",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "test": "node tests/chat-security.test.js && node tools/smoke-node.js && node tools/interaction-test.js && node tools/cycle-test.js",
    "lint": "eslint .",
    "check": "node tools/syntax-check.js",
    "typecheck": "tsc -p jsconfig.json",
    "prepare": "git config core.hooksPath .githooks",
    "visual": "LD_LIBRARY_PATH=/tmp/al2023-libs/lib FONTCONFIG_PATH=/tmp/fonts node tools/visual-check.js",
    "visual:local": "node tools/visual-check.js",
    "ui:audit": "node tools/ui-audit.js",
    "test:security": "python tools/test-security.py",
    "test:html": "html-validate index.html"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.16",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "highlight.js": "^11.12.0",
    "html-validate": "^11.4.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3"
  },
  "type": "commonjs",
  "overrides": {
    "fast-xml-parser": "^5.11.1"
  }
}
