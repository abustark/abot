{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false
  },
  "include": [
    "js/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vendor",
    "tmp",
    ".playwright",
    ".playwright-cli",
    ".agents",
    ".claude"
  ]
}
