rules_version = '2';

// ABot Firestore security rules
// Data model: users/{uid}/chats/{chatId} — per-user private chat storage.
//
// Deploy:
//   firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
//
// NOTE: review in Firebase Console before deploying. If you use composite
// features later (shared chats, public profiles), scope additional matches here.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's chat data is readable/writable only by that authenticated user.
    match /users/{uid}/chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else (implicit, but explicit for clarity).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
