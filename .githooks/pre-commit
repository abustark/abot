#!/bin/sh
# Pre-commit: version sync, then the quality gate (syntax + lint).
#
# 2.6.10: the version sync runs FIRST because git writes the commit tree from
# the index right after this hook — a file staged later (e.g. in commit-msg)
# would miss the commit it belongs to. sync-version.js reads the newest
# "### <version> - ..." entry from docs/COMMIT-HISTORY.md, writes APP_VERSION in
# js/config.js, advances the "Next version" line and stages both. commit-msg
# then verifies that the subject agrees with it.
echo "[pre-commit] Syncing release version..."
node tools/sync-version.js --from-history || { echo "[pre-commit] Version sync failed! Aborting commit."; exit 1; }

echo "[pre-commit] Checking syntax of JavaScript files..."
npm run check || { echo "[pre-commit] Syntax check failed! Aborting commit."; exit 1; }

echo "[pre-commit] Running ESLint..."
npm run lint || { echo "[pre-commit] Lint check failed! Aborting commit."; exit 1; }

echo "[pre-commit] Pre-commit quality gates passed! Proceeding with commit."
