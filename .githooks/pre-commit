#!/bin/sh
# Pre-commit quality gate: syntax and lint checks
echo "[pre-commit] Checking syntax of JavaScript files..."
npm run check || { echo "[pre-commit] Syntax check failed! Aborting commit."; exit 1; }

echo "[pre-commit] Running ESLint..."
npm run lint || { echo "[pre-commit] Lint check failed! Aborting commit."; exit 1; }

echo "[pre-commit] Pre-commit quality gates passed! Proceeding with commit."
